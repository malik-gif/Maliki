# Public browser configuration only. Never put TMDB or Supabase service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_UNSPLASH_ACCESS_KEY=
VITE_DEMO_MODE=false

# This static app does not read .env files directly.
# For local browser configuration, copy config.local.example.js to config.local.js
# and fill the two public values. config.local.js is ignored by Git.

# Supabase Edge Function secrets. Configure with `supabase secrets set`.
# TMDB_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_SECRET=
